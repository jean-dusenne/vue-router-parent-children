{
  "name": "vue-router-parent-children",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:refill": "cross-env VITE_APP_MODULE=refill vite",
    "dev:stock": "cross-env VITE_APP_MODULE=stock vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:refill": "cross-env VITE_APP_MODULE=refill vite build --outDir dist/refill",
    "build:stock": "cross-env VITE_APP_MODULE=stock vite build --outDir dist/stock",
    "serve": "node scripts/check-build.mjs default && vite preview --outDir dist/default",
    "serve:refill": "node scripts/check-build.mjs refill && vite preview --outDir dist/refill",
    "serve:stock": "node scripts/check-build.mjs stock && vite preview --outDir dist/stock",
    "preview": "npm run serve",
    "test:unit": "vitest",
    "build-only": "vite build --outDir dist/default",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
